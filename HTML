        /* MEJORA VISUAL: Imagen de fondo garantizada mediante enlace directo en línea */
        .hero {
            background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://upload.wikimedia.org/wikipedia/commons/2/23/Cerro_de_Pasco_open_pit_mine.jpg') no-repeat center center / cover !important;
