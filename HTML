            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #fff;
        }
        
        /* Contenedores de imágenes mejorados para mayor elegancia */
        .menu-img-container {
            width: 100%;
            height: 190px;
            overflow: hidden;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }
        .menu-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }
        .menu-item:hover .menu-img-container img {
            transform: scale(1.08);
        }

        /* Ajustes estéticos generales para un diseño más moderno y limpio */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 30px;
