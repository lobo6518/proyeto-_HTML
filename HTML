            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        .menu-details {
            padding: 20px;
        }
        .menu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
        .menu-header h3 {
